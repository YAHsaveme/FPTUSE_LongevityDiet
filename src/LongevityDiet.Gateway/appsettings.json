{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "current-api": {
        "ClusterId": "current-api",
        "Match": { "Path": "/api/{**catch-all}" }
      },
      "openapi": {
        "ClusterId": "current-api",
        "Match": { "Path": "/openapi/{**catch-all}" }
      }
    },
    "Clusters": {
      "current-api": {
        "HttpRequest": { "ActivityTimeout": "00:00:15" },
        "Destinations": {
          "api": { "Address": "http://127.0.0.1:8080/" }
        }
      }
    }
  }
}
