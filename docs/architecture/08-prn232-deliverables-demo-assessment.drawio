<mxCell id="r0" value="&lt;b&gt;5. Deliverables&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Submit:&lt;br&gt;- complete source code&lt;br&gt;- DB scripts or migrations&lt;br&gt;- Dockerfile(s)&lt;br&gt;- Docker Compose config if applicable&lt;br&gt;- Swagger/OpenAPI&lt;br&gt;- README: description, architecture, stack, installation, deployment, team responsibilities&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontFamily=Arial;align=left;verticalAlign=middle;spacing=16;fontSize=15;" vertex="1" parent="1"><mxGeometry x="120" y="240" width="1300" height="330" as="geometry"/></mxCell>
<mxCell id="m0" value="&lt;b&gt;maps to&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontColor=#000000;fontFamily=Arial;verticalAlign=middle;pointerEvents=0;fontSize=15;align=center;" vertex="1" parent="1"><mxGeometry x="1515" y="375" width="180" height="50" as="geometry"/></mxCell>
<mxCell id="e0" value="&lt;b&gt;Project mapping&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Repository evidence:&lt;br&gt;- source solution + frontend&lt;br&gt;- Dockerfiles + docker-compose.yml&lt;br&gt;- Swagger/OpenAPI&lt;br&gt;- architecture docs + README structure&lt;br&gt;- migrations/scripts become final evidence as implementation progresses&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;dashed=1;dashPattern=8 6;fontColor=#000000;fontFamily=Arial;align=left;verticalAlign=middle;spacing=16;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1810" y="240" width="1300" height="330" as="geometry"/></mxCell>
<mxCell id="r1" value="&lt;b&gt;6. Demonstration&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Final presentation must demonstrate:&lt;br&gt;- system architecture&lt;br&gt;- REST API functionality&lt;br&gt;- background job execution&lt;br&gt;- message publishing + consuming&lt;br&gt;- gRPC communication&lt;br&gt;- Docker/cloud deployment&lt;br&gt;- end-to-end workflow&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontFamily=Arial;align=left;verticalAlign=middle;spacing=16;fontSize=15;" vertex="1" parent="1"><mxGeometry x="120" y="600" width="1300" height="330" as="geometry"/></mxCell>
<mxCell id="m1" value="&lt;b&gt;maps to&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontColor=#000000;fontFamily=Arial;verticalAlign=middle;pointerEvents=0;fontSize=15;align=center;" vertex="1" parent="1"><mxGeometry x="1515" y="735" width="180" height="50" as="geometry"/></mxCell>
<mxCell id="e1" value="&lt;b&gt;Project mapping&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Use diagram 09 as the demo script.&lt;br&gt;It explicitly touches deployment, JWT/REST, SQL/EF Core, gRPC, Outbox, Worker, Redis producer/consumer, background result, Swagger/log evidence and final UI verification.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;dashed=1;dashPattern=8 6;fontColor=#000000;fontFamily=Arial;align=left;verticalAlign=middle;spacing=16;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1810" y="600" width="1300" height="330" as="geometry"/></mxCell>
<mxCell id="r2" value="&lt;b&gt;7. Assessment Criteria&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Exact weights:&lt;br&gt;- Architecture/design: 20%&lt;br&gt;- REST API: 20%&lt;br&gt;- Background Job: 10%&lt;br&gt;- Message Broker: 15%&lt;br&gt;- gRPC: 15%&lt;br&gt;- Docker/Cloud: 10%&lt;br&gt;- Documentation/presentation: 10%&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontFamily=Arial;align=left;verticalAlign=middle;spacing=16;fontSize=15;" vertex="1" parent="1"><mxGeometry x="120" y="960" width="1300" height="330" as="geometry"/></mxCell>
<mxCell id="m2" value="&lt;b&gt;maps to&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontColor=#000000;fontFamily=Arial;verticalAlign=middle;pointerEvents=0;fontSize=15;align=center;" vertex="1" parent="1"><mxGeometry x="1515" y="1095" width="180" height="50" as="geometry"/></mxCell>
<mxCell id="e2" value="&lt;b&gt;Project mapping&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Evidence organization:&lt;br&gt;- 01-04: architecture/design&lt;br&gt;- 05: gRPC runtime&lt;br&gt;- 06: broker + background runtime&lt;br&gt;- 03: deployment&lt;br&gt;- 07-08: traceability&lt;br&gt;- 09: final demonstration flow&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;dashed=1;dashPattern=8 6;fontColor=#000000;fontFamily=Arial;align=left;verticalAlign=middle;spacing=16;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1810" y="960" width="1300" height="330" as="geometry"/></mxCell>
<mxCell id="r3" value="&lt;b&gt;8. Notes&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Course notes:&lt;br&gt;- individual or team work per policy&lt;br&gt;- domain is open&lt;br&gt;- all required technologies must be clearly demonstrated&lt;br&gt;- well-designed additional features may receive bonus consideration&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontFamily=Arial;align=left;verticalAlign=middle;spacing=16;fontSize=15;" vertex="1" parent="1"><mxGeometry x="120" y="1320" width="1300" height="330" as="geometry"/></mxCell>
<mxCell id="m3" value="&lt;b&gt;maps to&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontColor=#000000;fontFamily=Arial;verticalAlign=middle;pointerEvents=0;fontSize=15;align=center;" vertex="1" parent="1"><mxGeometry x="1515" y="1455" width="180" height="50" as="geometry"/></mxCell>
<mxCell id="e3" value="&lt;b&gt;Project mapping&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Chosen domain: Longevity Diet Companion.&lt;br&gt;Architecture remains a manageable modular distributed application for a 4-person / 9-week plan.&lt;br&gt;Optional AI is bonus-only and cannot break the deterministic core.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;dashed=1;dashPattern=8 6;fontColor=#000000;fontFamily=Arial;align=left;verticalAlign=middle;spacing=16;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1810" y="1320" width="1300" height="330" as="geometry"/></mxCell>
