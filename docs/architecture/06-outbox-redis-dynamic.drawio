<mxCell id="e2" value="" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=0;html=1;strokeColor=#000000;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;curved=0;sourceJettySize=0;targetJettySize=0;endSize=10;" edge="1" parent="1" source="api" target="sql1"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="e3" value="" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=0;html=1;strokeColor=#000000;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;curved=0;sourceJettySize=0;targetJettySize=0;endSize=10;" edge="1" parent="1" source="sql1" target="pub"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="e4" value="" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=0;html=1;strokeColor=#000000;strokeWidth=2;dashed=1;dashPattern=9 7;endArrow=block;endFill=1;exitX=1;exitY=0.35;entryX=0;entryY=0.35;curved=0;sourceJettySize=0;targetJettySize=0;endSize=10;" edge="1" parent="1" source="pub" target="redis"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="e5" value="" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=0;html=1;strokeColor=#000000;strokeWidth=2;dashed=1;dashPattern=9 7;endArrow=block;endFill=1;exitX=1;exitY=0.35;entryX=0;entryY=0.35;curved=0;sourceJettySize=0;targetJettySize=0;endSize=10;" edge="1" parent="1" source="redis" target="con"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="e6" value="" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=0;html=1;strokeColor=#000000;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;curved=0;sourceJettySize=0;targetJettySize=0;endSize=10;" edge="1" parent="1" source="con" target="sql2"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="e7" value="" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=0;html=1;strokeColor=#000000;strokeWidth=2;dashed=1;dashPattern=9 7;endArrow=block;endFill=1;exitX=0;exitY=0.82;entryX=1;entryY=0.82;curved=0;sourceJettySize=0;targetJettySize=0;endSize=10;" edge="1" parent="1" source="con" target="redis"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="l1" value="1. User action&lt;br&gt;[HTTPS / JSON + JWT]" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontColor=#000000;fontFamily=Arial;verticalAlign=middle;pointerEvents=0;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="435" y="505" width="80" height="58" as="geometry" /></mxCell>
<mxCell id="l2" value="2. Commit state + OutboxMessage&lt;br&gt;[single EF Core / TDS transaction]" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontColor=#000000;fontFamily=Arial;verticalAlign=middle;pointerEvents=0;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="915" y="480" width="80" height="70" as="geometry" /></mxCell>
<mxCell id="l3" value="3. Poll pending outbox rows&lt;br&gt;[EF Core / TDS]" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontColor=#000000;fontFamily=Arial;verticalAlign=middle;pointerEvents=0;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="1405" y="495" width="80" height="58" as="geometry" /></mxCell>
<mxCell id="l4" value="4. Publish event&lt;br&gt;[XADD]" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontColor=#000000;fontFamily=Arial;verticalAlign=middle;pointerEvents=0;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="1885" y="495" width="80" height="52" as="geometry" /></mxCell>
<mxCell id="l5" value="5. Queued entry available&lt;br&gt;[Redis consumer group]" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontColor=#000000;fontFamily=Arial;verticalAlign=middle;pointerEvents=0;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="2365" y="495" width="80" height="52" as="geometry" /></mxCell>
<mxCell id="l6" value="6. Idempotency + job result&lt;br&gt;[ProcessedEvent / EF Core / TDS]" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontColor=#000000;fontFamily=Arial;verticalAlign=middle;pointerEvents=0;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="2875" y="480" width="80" height="70" as="geometry" /></mxCell>
<mxCell id="l7" value="7. Success XACK&lt;br&gt;or XADD to dead-letter after retry exhaustion" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontColor=#000000;fontFamily=Arial;verticalAlign=middle;pointerEvents=0;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="2180" y="825" width="520" height="58" as="geometry" /></mxCell>
<mxCell id="note" value="&lt;b&gt;Diagram Readability Note&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;[Dynamic-view convention]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;The two SQL Server shapes are two views of the same logical database instance, duplicated only to keep the runtime sequence linear and avoid a misleading return connector.&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontFamily=Arial;align=center;verticalAlign=middle;spacing=12;fontSize=14;" vertex="1" parent="1"><mxGeometry x="760" y="1030" width="2060" height="170" as="geometry" /></mxCell>
<mxCell id="delivery" value="&lt;b&gt;Delivery Model&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;[Architecture Rule]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;At-least-once delivery. ProcessedEvent prevents duplicate side effects. Redis is not part of the API business transaction because the durable OutboxMessage remains in SQL until publication succeeds.&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontFamily=Arial;align=center;verticalAlign=middle;spacing=12;fontSize=14;" vertex="1" parent="1"><mxGeometry x="760" y="1250" width="2060" height="170" as="geometry" /></mxCell>
<mxCell id="legend" value="Target view: solid = HTTP/SQL synchronous step | dashed = Redis Streams async operation | Publisher + Consumer are planned components inside one LongevityDiet.Worker container" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontColor=#000000;fontFamily=Arial;verticalAlign=middle;pointerEvents=0;fontSize=12;align=left;" vertex="1" parent="1"><mxGeometry x="90" y="1510" width="1900" height="36" as="geometry" /></mxCell>
</root>
</mxGraphModel>
</diagram>
</mxfile>
