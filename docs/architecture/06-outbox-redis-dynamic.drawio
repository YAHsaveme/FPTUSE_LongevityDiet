<mxCell id="title" value="&lt;b&gt;Transactional Outbox and Redis Streams - Target Dynamic Flow&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontColor=#000000;fontFamily=Arial;verticalAlign=middle;pointerEvents=0;fontSize=27;align=left;" vertex="1" parent="1"><mxGeometry x="90" y="45" width="3420" height="44" as="geometry" /></mxCell>
<mxCell id="sub" value="C4 Dynamic View | Target interaction sequence | two SQL shapes represent the same logical database" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontColor=#000000;fontFamily=Arial;verticalAlign=middle;pointerEvents=0;fontSize=14;align=left;" vertex="1" parent="1"><mxGeometry x="90" y="95" width="3420" height="34" as="geometry" /></mxCell>
<mxCell id="web" value="&lt;b&gt;LongevityDiet.Web&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;[Container]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;Submits a business action such as MealLogged.&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontFamily=Arial;align=center;verticalAlign=middle;spacing=12;fontSize=14;" vertex="1" parent="1"><mxGeometry x="70" y="560" width="360" height="210" as="geometry" /></mxCell>
<mxCell id="api" value="&lt;b&gt;LongevityDiet.API&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;[Container]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;ASP.NET Core REST API&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;Validates request and commits business state with OutboxMessage.&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontFamily=Arial;align=center;verticalAlign=middle;spacing=12;fontSize=14;" vertex="1" parent="1"><mxGeometry x="520" y="540" width="390" height="250" as="geometry" /></mxCell>
<mxCell id="sql1" value="&lt;b&gt;SQL Server&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;[Same Logical Database - Commit View]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;SQL Server 2022 | EF Core/TDS&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;Commits business state + OutboxMessage in one transaction.&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=18;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontFamily=Arial;align=center;verticalAlign=middle;spacing=12;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1000" y="540" width="400" height="250" as="geometry" /></mxCell>
<mxCell id="pub" value="&lt;b&gt;Outbox Publisher&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;[Component - Planned]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;LongevityDiet.Worker&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;Polls unpublished outbox rows and publishes domain events.&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontFamily=Arial;align=center;verticalAlign=middle;spacing=12;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1490" y="540" width="390" height="250" as="geometry" /></mxCell>
<mxCell id="redis" value="&lt;b&gt;Application Event Streams&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;[Container - Queue/Topic Data Store]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;Redis 7 Streams&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;Persists domain/notification events and dead-letter stream.&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontFamily=Arial;align=center;verticalAlign=middle;spacing=12;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1970" y="540" width="390" height="250" as="geometry" /></mxCell>
<mxCell id="con" value="&lt;b&gt;Event Consumer / Job Processor&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;[Component - Planned]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;LongevityDiet.Worker&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;Consumes group messages, checks idempotency, executes jobs and retries.&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontFamily=Arial;align=center;verticalAlign=middle;spacing=12;fontSize=14;" vertex="1" parent="1"><mxGeometry x="2450" y="540" width="420" height="250" as="geometry" /></mxCell>
<mxCell id="sql2" value="&lt;b&gt;SQL Server&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;[Same Logical Database - Result View]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;SQL Server 2022 | EF Core/TDS&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;Stores ProcessedEvent and background-job result/state.&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=18;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontFamily=Arial;align=center;verticalAlign=middle;spacing=12;fontSize=14;" vertex="1" parent="1"><mxGeometry x="2960" y="540" width="400" height="250" as="geometry" /></mxCell>
