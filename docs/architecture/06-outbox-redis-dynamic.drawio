dth="2300" height="70" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;Delivery&lt;/b&gt;  At-least-once | consumer idempotent by EventId | retry before dead-letter." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Arial;fontColor=#1F2937;fontSize=13;align=center;" vertex="1" parent="1"><mxGeometry x="850" y="1080" width="1800" height="42" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;Legend&lt;/b&gt;  Solid = SQL/local ownership | Dashed = Redis Streams async command" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Arial;fontColor=#1F2937;fontSize=12;align=left;" vertex="1" parent="1"><mxGeometry x="80" y="1310" width="1200" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>