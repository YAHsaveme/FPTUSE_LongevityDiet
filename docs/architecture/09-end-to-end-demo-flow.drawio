<root>
<mxCell id="0" />
<mxCell id="1" parent="0" />
<mxCell id="title" value="&lt;b&gt;PRN232 End-to-End Demonstration Flow&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontColor=#000000;fontFamily=Arial;verticalAlign=middle;pointerEvents=0;fontSize=27;align=left;" vertex="1" parent="1"><mxGeometry x="90" y="45" width="3220" height="44" as="geometry" /></mxCell>
<mxCell id="sub" value="Presentation sequence that proves every mandatory runtime technology in one coherent business scenario" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontColor=#000000;fontFamily=Arial;verticalAlign=middle;pointerEvents=0;fontSize=14;align=left;" vertex="1" parent="1"><mxGeometry x="90" y="95" width="3220" height="34" as="geometry" /></mxCell>
<mxCell id="pa" value="&lt;b&gt;PHASE A - SYNCHRONOUS USER WORKFLOW&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontColor=#000000;fontFamily=Arial;verticalAlign=middle;pointerEvents=0;fontSize=18;align=left;" vertex="1" parent="1"><mxGeometry x="110" y="170" width="1200" height="38" as="geometry" /></mxCell>
<mxCell id="a0" value="&lt;b&gt;1. Start system&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Run Docker Compose.&lt;br&gt;Show web, api, recommendation-grpc, worker, sqlserver and redis are running.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontFamily=Arial;align=left;verticalAlign=middle;spacing=16;fontSize=15;" vertex="1" parent="1"><mxGeometry x="110" y="240" width="540" height="230" as="geometry" /></mxCell>
<mxCell id="a1" value="&lt;b&gt;2. Authenticate&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Register/login through the Web UI.&lt;br&gt;API issues JWT and protects authenticated endpoints.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontFamily=Arial;align=left;verticalAlign=middle;spacing=16;fontSize=15;" vertex="1" parent="1"><mxGeometry x="750" y="240" width="540" height="230" as="geometry" /></mxCell>
<mxCell id="a2" value="&lt;b&gt;3. REST CRUD + query&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Create/update a core record.&lt;br&gt;Demonstrate REST naming plus search/filter/sort/pagination.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontFamily=Arial;align=left;verticalAlign=middle;spacing=16;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1390" y="240" width="540" height="230" as="geometry" /></mxCell>
<mxCell id="a3" value="&lt;b&gt;4. SQL persistence&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Show Services/Repository/EF Core persisting or querying SQL Server.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontFamily=Arial;align=left;verticalAlign=middle;spacing=16;fontSize=15;" vertex="1" parent="1"><mxGeometry x="2030" y="240" width="540" height="230" as="geometry" /></mxCell>
<mxCell id="a4" value="&lt;b&gt;5. gRPC recommendation&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Request recommendations.&lt;br&gt;API calls independent RankMeals gRPC service and returns ranked reasons.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontFamily=Arial;align=left;verticalAlign=middle;spacing=16;fontSize=15;" vertex="1" parent="1"><mxGeometry x="2670" y="240" width="540" height="230" as="geometry" /></mxCell>
<mxCell id="ae0" value="" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=0;html=1;strokeColor=#000000;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;curved=0;sourceJettySize=0;targetJettySize=0;endSize=10;" edge="1" parent="1" source="a0" target="a1"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="ae1" value="" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=0;html=1;strokeColor=#000000;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;curved=0;sourceJettySize=0;targetJettySize=0;endSize=10;" edge="1" parent="1" source="a1" target="a2"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="ae2" value="" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=0;html=1;strokeColor=#000000;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;curved=0;sourceJettySize=0;targetJettySize=0;endSize=10;" edge="1" parent="1" source="a2" target="a3"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="ae3" value="" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=0;html=1;strokeColor=#000000;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;curved=0;sourceJettySize=0;targetJettySize=0;endSize=10;" edge="1" parent="1" source="a3" target="a4"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="pb" value="&lt;b&gt;PHASE B - ASYNCHRONOUS MESSAGE + BACKGROUND WORKFLOW&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontColor=#000000;fontFamily=Arial;verticalAlign=middle;pointerEvents=0;fontSize=18;align=left;" vertex="1" parent="1"><mxGeometry x="110" y="650" width="1600" height="38" as="geometry" /></mxCell>
<mxCell id="b0" value="&lt;b&gt;6. Log business event&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Member logs meal/activity.&lt;br&gt;API commits business state + OutboxMessage in one SQL transaction.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontFamily=Arial;align=left;verticalAlign=middle;spacing=16;fontSize=15;" vertex="1" parent="1"><mxGeometry x="110" y="720" width="540" height="230" as="geometry" /></mxCell>
<mxCell id="b1" value="&lt;b&gt;7. Background publisher&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Worker polls pending OutboxMessage rows and publishes the domain event.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontFamily=Arial;align=left;verticalAlign=middle;spacing=16;fontSize=15;" vertex="1" parent="1"><mxGeometry x="750" y="720" width="540" height="230" as="geometry" /></mxCell>
<mxCell id="b2" value="&lt;b&gt;8. Broker producer&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Show Redis Streams XADD and verify the event appears in the selected stream.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontFamily=Arial;align=left;verticalAlign=middle;spacing=16;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1390" y="720" width="540" height="230" as="geometry" /></mxCell>
<mxCell id="b3" value="&lt;b&gt;9. Broker consumer&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Consumer group receives with XREADGROUP, checks idempotency, executes job and XACKs success.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontFamily=Arial;align=left;verticalAlign=middle;spacing=16;fontSize=15;" vertex="1" parent="1"><mxGeometry x="2030" y="720" width="540" height="230" as="geometry" /></mxCell>
<mxCell id="b4" value="&lt;b&gt;10. Background result&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Show recalculated score, reminder or weekly report persisted to SQL.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontFamily=Arial;align=left;verticalAlign=middle;spacing=16;fontSize=15;" vertex="1" parent="1"><mxGeometry x="2670" y="720" width="540" height="230" as="geometry" /></mxCell>
<mxCell id="be0" value="" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=0;html=1;strokeColor=#000000;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;curved=0;sourceJettySize=0;targetJettySize=0;endSize=10;" edge="1" parent="1" source="b0" target="b1"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="be1" value="" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=0;html=1;strokeColor=#000000;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;curved=0;sourceJettySize=0;targetJettySize=0;endSize=10;" edge="1" parent="1" source="b1" target="b2"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="be2" value="" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=0;html=1;strokeColor=#000000;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;curved=0;sourceJettySize=0;targetJettySize=0;endSize=10;" edge="1" parent="1" source="b2" target="b3"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="be3" value="" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=0;html=1;strokeColor=#000000;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;curved=0;sourceJettySize=0;targetJettySize=0;endSize=10;" edge="1" parent="1" source="b3" target="b4"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="pc" value="&lt;b&gt;PHASE C - VERIFICATION + PRESENTATION EVIDENCE&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontColor=#000000;fontFamily=Arial;verticalAlign=middle;pointerEvents=0;fontSize=18;align=left;" vertex="1" parent="1"><mxGeometry x="110" y="1140" width="1600" height="38" as="geometry" /></mxCell>
<mxCell id="c0" value="&lt;b&gt;11. End-to-end UI&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Refresh Web UI and show recommendation/progress/report data returned through REST.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontFamily=Arial;align=left;verticalAlign=middle;spacing=16;fontSize=15;" vertex="1" parent="1"><mxGeometry x="300" y="1210" width="760" height="240" as="geometry" /></mxCell>
<mxCell id="c1" value="&lt;b&gt;12. Technical evidence&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Show Swagger/OpenAPI, health endpoint, logs/errors, Redis producer/consumer evidence and Docker status.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontFamily=Arial;align=left;verticalAlign=middle;spacing=16;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1230" y="1210" width="760" height="240" as="geometry" /></mxCell>
<mxCell id="c2" value="&lt;b&gt;13. Architecture defense&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Use diagrams 01-08 to explain boundaries, protocols, layered API, gRPC independence, broker semantics and deployment.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontFamily=Arial;align=left;verticalAlign=middle;spacing=16;fontSize=15;" vertex="1" parent="1"><mxGeometry x="2160" y="1210" width="760" height="240" as="geometry" /></mxCell>
<mxCell id="ce0" value="" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=0;html=1;strokeColor=#000000;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;curved=0;sourceJettySize=0;targetJettySize=0;endSize=10;" edge="1" parent="1" source="c0" target="c1"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="ce1" value="" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=0;html=1;strokeColor=#000000;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;curved=0;sourceJettySize=0;targetJettySize=0;endSize=10;" edge="1" parent="1" source="c1" target="c2"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="check" value="&lt;b&gt;Presentation checklist&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;System architecture | REST API | Background Job | Message publishing + consuming | gRPC | Docker deployment | End-to-end workflow&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;dashed=1;dashPattern=8 6;fontColor=#000000;fontFamily=Arial;align=left;verticalAlign=middle;spacing=16;fontSize=15;" vertex="1" parent="1"><mxGeometry x="420" y="1630" width="2560" height="150" as="geometry" /></mxCell>
