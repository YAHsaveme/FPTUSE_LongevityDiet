<mxCell id="title" value="&lt;b&gt;PRN232 Requirements Coverage - Core Technical Requirements&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontColor=#000000;fontFamily=Arial;verticalAlign=middle;pointerEvents=0;fontSize=27;align=left;" vertex="1" parent="1"><mxGeometry x="90" y="45" width="3120" height="44" as="geometry"/></mxCell>
<mxCell id="sub" value="PDF sections 1-4 | Requirement-to-evidence traceability" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontColor=#000000;fontFamily=Arial;verticalAlign=middle;pointerEvents=0;fontSize=14;align=left;" vertex="1" parent="1"><mxGeometry x="90" y="95" width="3120" height="34" as="geometry"/></mxCell>
<mxCell id="h1" value="&lt;b&gt;Assignment requirement&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontColor=#000000;fontFamily=Arial;verticalAlign=middle;pointerEvents=0;fontSize=18;align=left;" vertex="1" parent="1"><mxGeometry x="120" y="155" width="1300" height="38" as="geometry"/></mxCell>
<mxCell id="h2" value="&lt;b&gt;Longevity Diet Companion evidence&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontColor=#000000;fontFamily=Arial;verticalAlign=middle;pointerEvents=0;fontSize=18;align=left;" vertex="1" parent="1"><mxGeometry x="1810" y="155" width="1300" height="38" as="geometry"/></mxCell>
<mxCell id="r0" value="&lt;b&gt;1. Objective&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Design, develop and deploy a distributed .NET application.&lt;br&gt;Must demonstrate:&lt;br&gt;- RESTful API&lt;br&gt;- asynchronous messaging&lt;br&gt;- background processing&lt;br&gt;- inter-service communication&lt;br&gt;- containerization / cloud-native deployment&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontFamily=Arial;align=left;verticalAlign=middle;spacing=16;fontSize=15;" vertex="1" parent="1"><mxGeometry x="120" y="225" width="1300" height="270" as="geometry"/></mxCell>
<mxCell id="m0" value="&lt;b&gt;maps to&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontColor=#000000;fontFamily=Arial;verticalAlign=middle;pointerEvents=0;fontSize=15;align=center;" vertex="1" parent="1"><mxGeometry x="1515" y="330" width="180" height="50" as="geometry"/></mxCell>
<mxCell id="e0" value="&lt;b&gt;Project mapping&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Architecture evidence:&lt;br&gt;- LongevityDiet.API&lt;br&gt;- LongevityDiet.Recommendation.Grpc&lt;br&gt;- LongevityDiet.Worker&lt;br&gt;- Redis Streams&lt;br&gt;- SQL Server&lt;br&gt;- Docker Compose&lt;br&gt;See diagrams 01-06.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;dashed=1;dashPattern=8 6;fontColor=#000000;fontFamily=Arial;align=left;verticalAlign=middle;spacing=16;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1810" y="225" width="1300" height="270" as="geometry"/></mxCell>
<mxCell id="r1" value="&lt;b&gt;2.1 REST API Service&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Required:&lt;br&gt;- ASP.NET Core REST API&lt;br&gt;- RESTful naming/principles&lt;br&gt;- CRUD for core entities&lt;br&gt;- API - Services - Repository layering&lt;br&gt;- JWT authentication&lt;br&gt;- search / filter / sort / pagination&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontFamily=Arial;align=left;verticalAlign=middle;spacing=16;fontSize=15;" vertex="1" parent="1"><mxGeometry x="120" y="515" width="1300" height="270" as="geometry"/></mxCell>
<mxCell id="m1" value="&lt;b&gt;maps to&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontColor=#000000;fontFamily=Arial;verticalAlign=middle;pointerEvents=0;fontSize=15;align=center;" vertex="1" parent="1"><mxGeometry x="1515" y="620" width="180" height="50" as="geometry"/></mxCell>
<mxCell id="e1" value="&lt;b&gt;Project mapping&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Evidence / target:&lt;br&gt;- LongevityDiet.API&lt;br&gt;- Controllers -&gt; Application Services -&gt; Repositories&lt;br&gt;- JWT at API boundary&lt;br&gt;- repository/query responsibility owns search/filter/sort/pagination&lt;br&gt;See diagram 04.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;dashed=1;dashPattern=8 6;fontColor=#000000;fontFamily=Arial;align=left;verticalAlign=middle;spacing=16;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1810" y="515" width="1300" height="270" as="geometry"/></mxCell>
<mxCell id="r2" value="&lt;b&gt;2.2 Background Job&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;At least one background service.&lt;br&gt;PDF examples include:&lt;br&gt;- notifications / emails&lt;br&gt;- data synchronization&lt;br&gt;- report generation&lt;br&gt;- cleanup&lt;br&gt;- inventory updates&lt;br&gt;- other business jobs&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontFamily=Arial;align=left;verticalAlign=middle;spacing=16;fontSize=15;" vertex="1" parent="1"><mxGeometry x="120" y="805" width="1300" height="270" as="geometry"/></mxCell>
<mxCell id="m2" value="&lt;b&gt;maps to&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontColor=#000000;fontFamily=Arial;verticalAlign=middle;pointerEvents=0;fontSize=15;align=center;" vertex="1" parent="1"><mxGeometry x="1515" y="910" width="180" height="50" as="geometry"/></mxCell>
<mxCell id="e2" value="&lt;b&gt;Project mapping&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;LongevityDiet.Worker responsibilities:&lt;br&gt;- Outbox publisher&lt;br&gt;- Redis consumer&lt;br&gt;- adherence/score recalculation&lt;br&gt;- reminders&lt;br&gt;- weekly reports&lt;br&gt;- retries / dead-letter handling&lt;br&gt;See 02 and 06.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;dashed=1;dashPattern=8 6;fontColor=#000000;fontFamily=Arial;align=left;verticalAlign=middle;spacing=16;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1810" y="805" width="1300" height="270" as="geometry"/></mxCell>
<mxCell id="r3" value="&lt;b&gt;2.3 Message Broker&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Asynchronous communication using:&lt;br&gt;- Apache Kafka OR&lt;br&gt;- Redis Pub/Sub / Streams&lt;br&gt;Must demonstrate at least one producer and one consumer.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontFamily=Arial;align=left;verticalAlign=middle;spacing=16;fontSize=15;" vertex="1" parent="1"><mxGeometry x="120" y="1095" width="1300" height="270" as="geometry"/></mxCell>
<mxCell id="m3" value="&lt;b&gt;maps to&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontColor=#000000;fontFamily=Arial;verticalAlign=middle;pointerEvents=0;fontSize=15;align=center;" vertex="1" parent="1"><mxGeometry x="1515" y="1200" width="180" height="50" as="geometry"/></mxCell>
<mxCell id="e3" value="&lt;b&gt;Project mapping&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Chosen: Redis Streams.&lt;br&gt;Producer: Worker -&gt; XADD.&lt;br&gt;Consumer: Worker consumer group -&gt; XREADGROUP / XACK.&lt;br&gt;Dead-letter stream included.&lt;br&gt;See diagram 06.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;dashed=1;dashPattern=8 6;fontColor=#000000;fontFamily=Arial;align=left;verticalAlign=middle;spacing=16;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1810" y="1095" width="1300" height="270" as="geometry"/></mxCell>
<mxCell id="r4" value="&lt;b&gt;2.4 gRPC Service&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Develop an independent gRPC service.&lt;br&gt;Demonstrate REST API interaction with it.&lt;br&gt;PDF examples include Recommendation, Pricing, AI/ML, Inventory and User Profile.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontFamily=Arial;align=left;verticalAlign=middle;spacing=16;fontSize=15;" vertex="1" parent="1"><mxGeometry x="120" y="1385" width="1300" height="270" as="geometry"/></mxCell>
<mxCell id="m4" value="&lt;b&gt;maps to&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontColor=#000000;fontFamily=Arial;verticalAlign=middle;pointerEvents=0;fontSize=15;align=center;" vertex="1" parent="1"><mxGeometry x="1515" y="1490" width="180" height="50" as="geometry"/></mxCell>
<mxCell id="e4" value="&lt;b&gt;Project mapping&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;LongevityDiet.Recommendation.Grpc is independent.&lt;br&gt;LongevityDiet.API invokes RankMeals over gRPC / HTTP2.&lt;br&gt;Chosen use case: Recommendation.&lt;br&gt;See 02, 04 and 05.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;dashed=1;dashPattern=8 6;fontColor=#000000;fontFamily=Arial;align=left;verticalAlign=middle;spacing=16;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1810" y="1385" width="1300" height="270" as="geometry"/></mxCell>
<mxCell id="r5" value="&lt;b&gt;3. Deployment Requirements&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Deploy using either:&lt;br&gt;- Docker Desktop + Docker Compose OR&lt;br&gt;- public cloud&lt;br&gt;All required services must communicate successfully.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontFamily=Arial;align=left;verticalAlign=middle;spacing=16;fontSize=15;" vertex="1" parent="1"><mxGeometry x="120" y="1675" width="1300" height="270" as="geometry"/></mxCell>
<mxCell id="m5" value="&lt;b&gt;maps to&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontColor=#000000;fontFamily=Arial;verticalAlign=middle;pointerEvents=0;fontSize=15;align=center;" vertex="1" parent="1"><mxGeometry x="1515" y="1780" width="180" height="50" as="geometry"/></mxCell>
<mxCell id="e5" value="&lt;b&gt;Project mapping&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Primary assignment path:&lt;br&gt;- Docker Desktop&lt;br&gt;- Docker Compose&lt;br&gt;- web / api / recommendation-grpc / worker / sqlserver / redis&lt;br&gt;- ldc-network + persistent volumes&lt;br&gt;See diagram 03.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;dashed=1;dashPattern=8 6;fontColor=#000000;fontFamily=Arial;align=left;verticalAlign=middle;spacing=16;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1810" y="1675" width="1300" height="270" as="geometry"/></mxCell>
<mxCell id="r6" value="&lt;b&gt;4. Technical Requirements&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Must demonstrate:&lt;br&gt;- ASP.NET Core .NET 8+&lt;br&gt;- EF Core + relational DB&lt;br&gt;- DI + configuration&lt;br&gt;- logging + exception handling&lt;br&gt;- JWT + REST&lt;br&gt;- gRPC + broker + Background Service&lt;br&gt;- Docker&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontFamily=Arial;align=left;verticalAlign=middle;spacing=16;fontSize=15;" vertex="1" parent="1"><mxGeometry x="120" y="1965" width="1300" height="270" as="geometry"/></mxCell>
<mxCell id="m6" value="&lt;b&gt;maps to&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontColor=#000000;fontFamily=Arial;verticalAlign=middle;pointerEvents=0;fontSize=15;align=center;" vertex="1" parent="1"><mxGeometry x="1515" y="2070" width="180" height="50" as="geometry"/></mxCell>
<mxCell id="e6" value="&lt;b&gt;Project mapping&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Target stack:&lt;br&gt;- .NET 9 / ASP.NET Core / EF Core 9&lt;br&gt;- SQL Server 2022&lt;br&gt;- built-in DI/configuration&lt;br&gt;- Serilog + controlled errors&lt;br&gt;- JWT / REST / gRPC / Redis Streams / Worker / Docker Compose&lt;br&gt;See 02-04.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;dashed=1;dashPattern=8 6;fontColor=#000000;fontFamily=Arial;align=left;verticalAlign=middle;spacing=16;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1810" y="1965" width="1300" height="270" as="geometry"/></mxCell>
<mxCell id="src" value="Source: PRN232 Final Assignment, sections 1-4. Compliance view only; not a C4 abstraction level." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontColor=#000000;fontFamily=Arial;verticalAlign=middle;pointerEvents=0;fontSize=12;align=left;" vertex="1" parent="1"><mxGeometry x="120" y="2230" width="2500" height="34" as="geometry"/></mxCell>
</root>
</mxGraphModel>
