ersistence&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#555555&quot;&gt;[Component • EF Core Repository]&lt;br/&gt;Users, profile, preferences, sessions, notifications, outbox&lt;/font&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=3;fontFamily=Arial;fontSize=27;fontColor=#222222;align=center;verticalAlign=middle;spacing=12;shadow=0;" vertex="1" parent="1"><mxGeometry x="1200" y="1790" width="1240" height="250" as="geometry"/></mxCell><mxCell id="n17" value="&lt;b&gt;Identity Redis Bridge&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#555555&quot;&gt;[Component • Hosted Service]&lt;br/&gt;Poll outbox; consume results into inbox&lt;/font&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=3;fontFamily=Arial;fontSize=26;fontColor=#222222;align=center;verticalAlign=middle;spacing=12;shadow=0;" vertex="1" parent="1"><mxGeometry x="2580" y="1790" width="750" height="250" as="geometry"/></mxCell><mxCell id="n18" value="&lt;b&gt;Tracking Persistence&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#555555&quot;&gt;[Component • EF Core DbContext]&lt;br/&gt;Activities, goals and partial LDAS&lt;/font&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=3;fontFamily=Arial;fontSize=27;fontColor=#222222;align=center;verticalAlign=middle;spacing=12;shadow=0;" vertex="1" parent="1"><mxGeometry x="3470" y="1790" width="750" height="250" as="geometry"/></mxCell><mxCell id="n19" value="&lt;b&gt;Recommendation gRPC&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#555555&quot;&gt;[External Container • HTTP/2]&lt;br/&gt;ActivityCoach.Recommend&lt;/font&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=3;fontFamily=Arial;fontSize=27;fontColor=#222222;align=center;verticalAlign=middle;spacing=12;shadow=0;" vertex="1" parent="1"><mxGeometry x="5380" y="1090" width="590" height="280" as="geometry"/></mxCell><mxCell id="n20" value="&lt;b&