ty SQL Database&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#555555&quot;&gt;[External Data Store]&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#555555&quot;&gt;Owned data and local FKs&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#222222;strokeWidth=3;fontColor=#222222;fontSize=31;fontFamily=Arial;align=center;verticalAlign=middle;spacing=12;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="1390" y="2850" width="1250" height="220" as="geometry"/></mxCell><mxCell id="d33" value="&lt;b&gt;Redis Streams&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#555555&quot;&gt;[External Broker]&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#555555&quot;&gt;Identity events / Worker results&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#222222;strokeWidth=3;fontColor=#222222;fontSize=30;fontFamily=Arial;align=center;verticalAlign=middle;spacing=12;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="2830" y="2850" width="740" height="220" as="geometry"/></mxCell><mxCell id="d34" value="&lt;b&gt;Tracking SQL Database&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#555555&quot;&gt;[External Data Store]&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#555555&quot;&gt;Activity / scores&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#222222;strokeWidth=3;fontColor=#222222;fontSize=31;fontFamily=Arial;align=center;verticalAlign=middle;spacing=12;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="3700" y="2850" width="810" height="220" as="geometry"/></mxCell><mxCell id="d46" value="A. RecommendationController -&gt; TrackingService (own summary) -&gt; gRPC Client -&gt; Recommendation Service -&gt; JSON response." style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#555555;fontFamily=Arial;fontSize=26;fontStyle=0;align=left;verticalAlign=middle;spacing=1;" vertex="1" parent="1"><mxGeometry x="1020" y="3130" width="5520" height="60" as="geometry"/></mxCell><mxC