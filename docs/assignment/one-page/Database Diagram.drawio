ispatchRecords&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#9AABBA&quot;&gt;------------------------------------&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#16674C&quot;&gt;&lt;b&gt;PK Id&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#9D6422&quot;&gt;LNK UserId&lt;/font&gt;&lt;br/&gt;DueAtUtc" style="rounded=0;fontFamily=Arial;fontColor=#18283D;whiteSpace=wrap;html=1;strokeColor=#6A8296;strokeWidth=3;fillColor=#F9FBFD;fontSize=58;align=left;verticalAlign=middle;spacingLeft=19;spacingTop=10;spacingBottom=10;" vertex="1" parent="1"><mxGeometry x="2060" y="5260" width="1640" height="600" as="geometry"/></mxCell><mxCell id="erd45" value="&lt;b&gt;WorkerProcessedEvents&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#9AABBA&quot;&gt;------------------------------------&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#16674C&quot;&gt;&lt;b&gt;PK EventId&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;ProcessedAtUtc" style="rounded=0;fontFamily=Arial;fontColor=#18283D;whiteSpace=wrap;html=1;strokeColor=#6A8296;strokeWidth=3;fillColor=#F9FBFD;fontSize=58;align=left;verticalAlign=middle;spacingLeft=19;spacingTop=10;spacingBottom=10;" vertex="1" parent="1"><mxGeometry x="3890" y="5260" width="1640" height="600" as="geometry"/></mxCell><mxCell id="erd46" value="&lt;b&gt;WorkerOutbox&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#9AABBA&quot;&gt;------------------------------------&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#16674C&quot;&gt;&lt;b&gt;PK EventId&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;EventType&lt;br/&gt;PublishedAtUtc" style="rounded=0;fontFamily=Arial;fontColor=#18283D;whiteSpace=wrap;html=1;strokeColor=#6A8296;strokeWidth=3;fillColor=#F9FBFD;fontSize=58;align=left;verticalAlign=middle;spacingLeft=19;spacingTop=10;spacingBottom=10;" vertex="1" parent="1"><mxGeometry x="5720" y="5260" width="1640" height="600" as="geometry"/></mxCell><mxCell id="erd65" value="&lt;b&gt;CÁCH ĐỌC ERD&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#123E68&quot;&gt;&lt;b&gt;── 1 / N (Crow’s Foot)&lt;/b&gt;&lt;/font&gt; = FK thật do SQL Server kiểm soát.&lt;br/&gt;&lt;font color=&quot;#9D6422&quot;&gt;&lt;b&gt;┄┄ liên kết logic&lt;/b&gt;&lt;/font&gt; = các khóa UserId, MealPlanId, PlannedMealId, Version trong code; không phải FK.&lt;br/&gt;Outbox/Inbox và một số bảng sự kiện độc lập không cần SQL FK. Không nối giả bảng thiếu ràng buộc." style="rounded=1;fontFamily=Arial;fontColor=#18283D;whiteSpace=wrap;html=1;strokeColor=#C3CFDA;strokeWidth=2;fillColor=#EFF6FA;fontSize=54;align=left;verticalAlign=middle;spacing=27;" vertex="1" parent="1"><mxGeometry x="7840" y="6115" width="7720" height="790" as="geometry"/></mxCell><mxCell id="erd66" value="&lt;b&gt;NHÌN THEO LUỒNG&lt;/b&gt;   Users → UserProfiles, RefreshTokens, ReminderPreferences, UserNotifications   |   MealPlans → MealPlanDays → PlannedMeals   |   MealLogs → MealLogItems   |   FmdCycles → FmdCycleDays   |   AdherenceScores → ScoreDimensions.&lt;br/&gt;Toàn bộ 32 bảng có thật; 9 FK (đường liền xanh đậm) và 9 liên kết logic (nét đứt vàng). Không tạo thêm FK/database ngoài code thực tế." style="rounded=1;fontFamily=Arial;fontColor=#18283D;whiteSpace=wrap;html=1;strokeColor=#D2AA73;strokeWidth=2;fillColor=#FFF7E7;fontSize=57;align=left;verticalAlign=middle;spacing=30;" vertex="1" parent="1"><mxGeometry x="145" y="6940" width="15430" height="680" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>