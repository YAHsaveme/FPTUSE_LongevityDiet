="1750" height="75" as="geometry"/></mxCell><mxCell id="subtitle" value="Ranh giới hệ thống, hai tác nhân và hai quan hệ nghiệp vụ." style="rounded=0;html=1;whiteSpace=wrap;strokeColor=#000000;strokeWidth=1.6;fillColor=#FFFFFF;fontColor=#000000;fontFamily=Arial;fontSize=22;fontStyle=0;verticalAlign=middle;align=left;spacing=7;text;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="70" y="120" width="1975" height="51" as="geometry"/></mxCell><mxCell id="rule" value="" style="rounded=0;html=1;whiteSpace=wrap;strokeColor=#000000;strokeWidth=0;fillColor=#FFFFFF;fontColor=#000000;fontFamily=Arial;fontSize=22;fontStyle=0;verticalAlign=middle;align=center;spacing=7;" vertex="1" parent="1"><mxGeometry x="70" y="187" width="1980" height="3" as="geometry"/></mxCell><mxCell id="member" value="NGƯỜI DÙNG&lt;br/&gt;Member" style="rounded=0;html=1;whiteSpace=wrap;strokeColor=#000000;strokeWidth=2.4;fillColor=#FFFFFF;fontColor=#000000;fontFamily=Arial;fontSize=29;fontStyle=0;verticalAlign=middle;align=center;spacing=7;shape=umlActor;labelPosition=center;verticalLabelPosition=bottom;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="150" y="380" width="250" height="160" as="geometry"/></mxCell><mxCell id="admin" value="QUẢN TRỊ&lt;br/&gt;Admin" style="rounded=0;html=1;whiteSpace=wrap;strokeColor=#000000;strokeWidth=2.4;fillColor=#FFFFFF;fontColor=#000000;fontFamily=Arial;fontSize=29;fontStyle=0;verticalAlign=middle;align=center;spacing=7;shape=umlActor;labelPosition=center;verticalLabelPosition=bottom;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="150" y="780" width="250" height="160" as="geometry"/></mxCell><mxCell id="system" value="LONGEVITYDIET&lt;br/&gt;Nền tảng quản lý chế độ ăn trường thọ&lt;br/&gt;&lt;br/&gt;Tài khoản - Hồ sơ - Thực đơn - Nhật ký&lt;br/&gt;Vận động - LDAS - FMD - Thử thách&lt;br/&gt;Thông báo - Báo cáo - Quản trị quy tắc" style="rounded=0;html=1;whiteSpace=wrap;strokeColor=#000000;strokeWidth=3;fillColor=#FFFFFF;fontColor