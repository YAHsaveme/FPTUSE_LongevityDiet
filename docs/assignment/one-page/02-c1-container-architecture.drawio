nter;verticalAlign=middle;spacing=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="2050" y="890" width="880" height="330" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;LongevityPlanningDb&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#555555&quot;&gt;SQL Server • logical ownership&lt;br/&gt;EF Core / TDS :1433&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;glass=0;fontFamily=Arial;fontSize=33;fontColor=#171717;fontStyle=0;align=center;verticalAlign=middle;spacing=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="2050" y="1465" width="880" height="230" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;TRACKING &amp; PROGRESS&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#555555&quot;&gt;REST :8084&lt;br/&gt;Meal/activity logs • LDAS&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;glass=0;fontFamily=Arial;fontSize=35;fontColor=#171717;fontStyle=0;align=center;verticalAlign=middle;spacing=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="3010" y="890" width="880" height="330" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;LongevityTrackingDb&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#555555&quot;&gt;SQL Server • logical ownership&lt;br/&gt;EF Core / TDS :1433&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;glass=0;fontFamily=Arial;fontSize=33;fontColor=#171717;fontStyle=0;align=center;verticalAlign=middle;spacing=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="3010" y="1465" width="880" height="230" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;RECOMMENDATION&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#555555&quot;&gt;gRPC HTTP/2 :8085&lt;br/&gt;Safety filtering • ranking&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;glass=0;fontFamily=Arial;fontSize=35;fontColor=#171717;fontStyle=0;align=center;verticalAlign=middle;spacing=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="3970" y="890" width="880" height="330" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;LongevityRecommendationDb&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#555555&quot;&gt;SQL Server • logical ownership&lt;br/&gt;EF Core / TDS :1433&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;glass=0;fontFamily=Arial;fontSize=33;fontColor=#171717;fontStyle=0;align=center;verticalAlign=middle;spacing=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="3970" y="1465" width="880" height="230" as="geometry"/></mxCell><mxCell id="c32" value="&lt;b&gt;BACKGROUND WORKER&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#555555&quot;&gt;Ops :8086&lt;br/&gt;Reminders • reports • retries&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;glass=0;fontFamily=Arial;fontSize=35;fontColor=#171717;fontStyle=0;align=center;verticalAlign=middle;spacing=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="4930" y="890" width="880" height="330" as="geometry"/></mxCell><mxCell id="c34" value="&lt;b&gt;LongevityWorkerDb&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#555555&quot;&gt;SQL Server • logical ownership&lt;br/&gt;EF Core / TDS :1433&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;glass=0;fontFamily=Arial;fontSize=33;fontColor=#171717;fontStyle=0;align=center;verticalAlign=middle;spacing=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="4930" y="1465" width="880" height="230" as="geometry"/></mxCell><mxCell id="c36" value="&lt;b&gt;SYNC:&lt;/b&gt; Gateway → 4 REST services / Worker Ops    ·    Planning → Recommendation gRPC    ·    No cross-service SQL reads or foreign keys" style="rounded=0;whiteSpace=wrap;html=1;glass=0;fontFamily=Arial;fontSize=30;fontColor=#171717;fontStyle=0;align=left;verticalAlign=middle;spacing=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="160" y="1795" width="5560" height="116" as="geometry"/></mxCell><mxCell id="c37" value="&lt;b&gt;DOMAIN OUTBOX PUBLISHERS&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#555555&quot;&gt;Identity / Catalog / Planning / Tracking&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;glass=0;fontFamily=Arial;fontSize=34;fontColor=#171717;fontStyle=0;align=center;verticalAlign=middle;spacing=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="420" y="1952" width="2410" height="174" as="geometry"/></mxCell><mxCell id="c38" value="&lt;b&gt;STREAM CONSUMERS + RESULT PUBLISHERS&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#555555&quot;&gt;Worker consumes &amp; acknowledges • Recommendation projects approved snapshots&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;glass=0;fontFamily=Arial;fontSize=32;fontColor=#171717;fontStyle=0;align=center;verticalAlign=middle;spacing=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="3150" y="1952" width="2410" height="174" as="geometry"/></mxCell><mxCell id="c39" value="&lt;b&gt;REDIS 7 STREAMS  •  SHARED EVENT TRANSPORT&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#555555&quot;&gt;Domain services publish transactional outbox events; Worker consumes via consumer group + XACK; result, retry and dead-letter events return to owners.&lt;br/&gt;NOT a relational database. Cross-service communication is via API/gRPC or versioned integration events.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;glass=0;fontFamily=Arial;fontSize=38;fontColor=#171717;fontStyle=0;align=center;verticalAlign=middle;spacing=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="400" y="2220" width="5100" height="390" as="geometry"/></mxCell><mxCell id="c42" value="&lt;b&gt;EVENT / DATA OWNERSHIP&lt;/b&gt;   Identity, Catalog, Planning, Tracking → Outbox → Redis → Worker / projected read models. Every service reads/writes ONLY its own logical database." style="rounded=0;whiteSpace=wrap;html=1;glass=0;fontFamily=Arial;fontSize=30;fontColor=#171717;fontStyle=0;align=left;verticalAlign=middle;spacing=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="390" y="2720" width="5120" height="200" as="geometry"/></mxCell><mxCell id="c43" value="&lt;b&gt;NOTATION:&lt;/b&gt; Solid arrows = synchronous HTTPS / gRPC or owned SQL DB access. Dashed arrows = asynchronous Redis Streams events. All boxes use standard black/white drafting.&lt;br/&gt;&lt;b&gt;Scope:&lt;/b&gt; ADR-005 TARGET architecture; current runtime still uses a shared ASP.NET Core API and partial service separation." style="rounded=0;whiteSpace=wrap;html=1;glass=0;fontFamily=Arial;fontSize=29;fontColor=#171717;fontStyle=0;align=left;verticalAlign=middle;spacing=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="140" y="3005" width="5630" height="165" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>