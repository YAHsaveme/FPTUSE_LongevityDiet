# Copy to .env for local/demo use. Replace every CHANGE_ME value before starting containers.
MSSQL_SA_PASSWORD=CHANGE_ME_Aa1!_LOCAL_DEMO_PASSWORD
JWT_SIGNING_KEY=CHANGE_ME_WITH_RANDOM_32_PLUS_CHARACTER_KEY
JWT_ISSUER=LongevityDiet.API
JWT_AUDIENCE=LongevityDiet.Web

# Host ports are loopback-bound by docker-compose.yml.
SQLSERVER_PORT=14330
REDIS_PORT=6379
API_PORT=8080
GRPC_PORT=8081
WEB_PORT=5173

# Email delivery is OFF in the default runtime. Only enable once SMTP,
# recipient email verification, unsubscribe/bounce and production security
# have been approved. Use deployment secrets; NEVER put passwords in Git.
# EmailNotifications__Enabled=false
# EmailNotifications__SmtpHost=smtp.gmail.com
# EmailNotifications__SmtpPort=587
# EmailNotifications__SmtpTls=true
# EmailNotifications__SmtpUser=<approved-sender-address>
# EmailNotifications__SmtpPassword=<secure-secret-not-committed>
# EmailNotifications__FromAddress=<approved-sender-address>
# EmailNotifications__PublicBaseUrl=https://<verified-domain>
# EmailNotifications__AllowedRecipientDomains=<verified-domain-allowlist>
# EmailNotifications__AllowAnyRecipientDomain=false
# RabbitMq__HostName=<private-broker>
# RabbitMq__Port=5671
# RabbitMq__UseTls=true
# RabbitMq__UserName=<broker-user>
# RabbitMq__Password=<broker-secret>

# Background browser Web Push (OFF by default). Generate your own VAPID
# key pair once and inject only from a secure runtime secret store.
# WebPush__Enabled=false
# WebPush__PublicKey=<generated-VAPID-public-key>
# WebPush__PrivateKey=<private-VAPID-key-never-commit>
# WebPush__Subject=mailto:<verified-operator-email>
