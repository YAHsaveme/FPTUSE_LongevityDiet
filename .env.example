# Copy to .env for local/demo use. Replace every CHANGE_ME value before starting containers.
MSSQL_SA_PASSWORD=CHANGE_ME_Aa1!_LOCAL_DEMO_PASSWORD
JWT_SIGNING_KEY=CHANGE_ME_WITH_RANDOM_32_PLUS_CHARACTER_KEY
JWT_ISSUER=LongevityDiet.API
JWT_AUDIENCE=LongevityDiet.Web

# Host ports are loopback-bound by docker-compose.yml.
SQLSERVER_PORT=14330
REDIS_PORT=6379
API_PORT=8080
GRPC_PORT=8081
WEB_PORT=5173
